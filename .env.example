# Password required to open the site. Copy this file to .env.local for local use.
#
# Leave it unset locally and the gate is disabled, so development is unchanged.
# In production an unset password locks the site rather than publishing it,
# so this must be set in your hosting provider's environment variables.
SITE_PASSWORD=choose-something-long

# Optional. When unset, any username works and only the password is checked,
# which is usually what you want for a link shared with a couple of people.
# SITE_USERNAME=

# Optional. Enables "Import from photo", which reads a screenshot of a
# brokerage account and extracts the holdings. Without it, that button returns
# a message saying the feature is not configured; everything else still works.
#
# Get a key at https://platform.openai.com/api-keys. Each import costs roughly
# a cent, and the route is rate limited to 5 per minute per visitor.
# OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o. A cheaper model such as gpt-4o-mini costs less
# but misreads share counts and decimals more often, which matters here.
# OPENAI_VISION_MODEL=gpt-4o
