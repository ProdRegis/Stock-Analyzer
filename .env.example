# Password required to open the site. Copy this file to .env.local for local use.
#
# Leave it unset locally and the gate is disabled, so development is unchanged.
# In production an unset password locks the site rather than publishing it,
# so this must be set in your hosting provider's environment variables.
SITE_PASSWORD=choose-something-long

# Optional. When unset, any username works and only the password is checked,
# which is usually what you want for a link shared with a couple of people.
# SITE_USERNAME=

# Optional. EDGAR sits behind Akamai and 403s script-style User-Agents
# from cloud hosts. Leave this unset: the app already sends a browser-like
# User-Agent. Only set this if you have a string that you have confirmed
# returns 200 from https://data.sec.gov/submissions/CIK0001067983.json
# SEC_USER_AGENT=
